# Hermes MCP server environment
# Used when running the MCP server manually (Claude Desktop passes these via its config).

# Live site (default). Change to http://localhost:3001 for local dev.
HERMES_BASE_URL=https://socialsched.vibeship.in

# Generate this from the live dashboard: /dashboard/hermes-connection -> Generate key
HERMES_API_KEY=hermes_PASTE_YOUR_KEY_HERE
