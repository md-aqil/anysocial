generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TWITTER
  TIKTOK
  YOUTUBE
  THREADS
  PINTEREST
  SNAPCHAT
  REDDIT
}

enum AccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum PostStatus {
  DRAFT
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  PARTIALLY_FAILED
  CANCELLED
}

enum FetchStatus {
  PENDING
  SUCCESS
  FAILED
  RATE_LIMITED
}

enum NotificationType {
  EMAIL
  WEBHOOK
  PUSH
  IN_APP
}

enum NotificationStatus {
  SENT
  FAILED
  RETRYING
  PENDING
}

enum WebhookEvent {
  POST_PUBLISHED
  POST_FAILED
  POST_VIRAL
  QUOTA_WARNING
}

model User {
  id                String                @id @default(uuid())
  email             String                @unique
  passwordHash      String                @map("password_hash")
  name              String?
  avatarUrl         String?               @map("avatar_url")
  role              String                @default("user") @map("role")
  socialAccounts    SocialAccount[]
  adCreatives       AdCreative[]
  oauthStates       OAuthState[]
  posts             Post[]
  webhooks          WebhookSubscription[]
  notifications     Notification[]
  notificationLogs  NotificationLog[]
  reelSeries        ReelSeries[]
  reels             Reel[]
  curatedPosts      CuratedPost[]
  playgroundImages  PlaygroundImage[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  AutomatedCampaign AutomatedCampaign[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model SocialAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          Platform
  externalAccountId String        @map("external_account_id")
  accessToken       String        @map("access_token")
  refreshToken      String?       @map("refresh_token")
  tokenExpiry       DateTime      @map("token_expiry")
  scopes            String[]      @default([])
  status            AccountStatus @default(CONNECTED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lastRefreshed     DateTime?     @map("last_refreshed")
  metadata          Json?

  @@unique([userId, platform, externalAccountId])
  @@index([userId, status])
  @@index([tokenExpiry])
  @@map("social_accounts")
}

model OAuthState {
  id          String   @id @default(uuid())
  platform    Platform
  stateToken  String   @unique @map("state_token")
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime @map("expires_at")
  pendingData Json?    @map("pending_data")
  isCompleted Boolean  @default(false) @map("is_completed")

  @@index([stateToken, expiresAt])
  @@map("oauth_states")
}

model Post {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  rawContent      String          @map("raw_content")
  mediaUrls       String[]        @map("media_urls")
  platforms       String[]
  timezone        String
  scheduledAt     DateTime?       @map("scheduled_at")
  publishedAt     DateTime?       @map("published_at")
  status          PostStatus      @default(DRAFT)
  platformResults Json[]          @map("platform_results")
  platformOptions Json?           @map("platform_options")
  retryCount      Int             @default(0) @map("retry_count")
  maxRetries      Int             @default(3) @map("max_retries")
  media           PostMedia[]
  analytics       PostAnalytics[]
  reels           Reel[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([userId, scheduledAt])
  @@index([publishedAt])
  @@map("posts")
}

model PostMedia {
  id               String   @id @default(uuid())
  postId           String
  post             Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  originalUrl      String   @map("original_url")
  platformVariants Json     @map("platform_variants")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  dimensions       Json
  validatedAt      DateTime @default(now())

  @@index([postId])
  @@map("post_media")
}

model PostAnalytics {
  id            String      @id @default(uuid())
  postId        String
  post          Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform      Platform
  publishedAt   DateTime    @map("published_at")
  metrics       Json        @map("metrics")
  lastFetchedAt DateTime    @map("last_fetched_at")
  fetchStatus   FetchStatus @default(PENDING)
  fetchError    String?     @map("fetch_error")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([postId, platform])
  @@index([postId])
  @@index([fetchStatus])
  @@map("post_analytics")
}

model WebhookSubscription {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpointUrl String   @map("endpoint_url")
  events      String[] @default([])
  secret      String   @map("secret")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isActive])
  @@map("webhook_subscriptions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType   @map("notification_type")
  event         String             @map("event_type")
  payload       Json?              @map("payload")
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0) @map("attempts")
  lastAttemptAt DateTime?          @map("last_attempt_at")
  errorMessage  String?            @map("error_message")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, status])
  @@index([status])
  @@map("notification_logs")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  actorEmail   String?  @map("actor_email")
  action       String   @map("action")
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@map("admin_audit_logs")
}

model AnalyticsRollup {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           DateTime @map("date")
  period         String   @map("period")
  platform       String?  @map("platform")
  totalPosts     Int      @default(0) @map("total_posts")
  published      Int      @default(0) @map("published")
  failed         Int      @default(0) @map("failed")
  totalLikes     Int      @default(0) @map("total_likes")
  totalComments  Int      @default(0) @map("total_comments")
  totalShares    Int      @default(0) @map("total_shares")
  totalReach     Int      @default(0) @map("total_reach")
  engagementRate Float    @default(0) @map("engagement_rate")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date, period, platform])
  @@index([userId, date, period])
  @@map("analytics_rollups")
}

model ReelSeries {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  niche          String?
  customPrompt   String?
  language       String
  voiceId        String
  musicId        String?
  artStyle       String
  duration       String            @default("30s")
  hookType       String?           @map("hook_type")
  tone           String?
  storyStructure String?           @map("story_structure")
  isActive       Boolean           @default(true) @map("is_active")
  scheduleDays   String            @default("[]") @map("schedule_days") // JSON array like ["MON", "WED", "FRI"]
  scheduleTime   String?           @map("schedule_time") // HH:mm format
  timezoneOffset Int?              @map("timezone_offset")
  socialChannels String            @default("[]") @map("social_channels") // JSON array of account IDs
  targetRegion   String            @default("Global") @map("target_region")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reels          Reel[]
  characters     SeriesCharacter[]
  locations      SeriesLocation[]
  objects        SeriesObject[]

  @@map("reel_series")
}

enum ReelType {
  SERIES
  PRODUCT
  VEO_SHORT
}

model Reel {
  id             String             @id @default(uuid())
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ReelType           @default(SERIES)
  seriesId       String?
  series         ReelSeries?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  script         String?
  videoUrl       String?
  thumbnail      String?
  status         String             @default("PENDING") // PENDING, GENERATING, READY, PUBLISHED, FAILED
  statusMessage  String?
  scheduledFor   DateTime?
  socialChannels String             @default("[]") // JSON array of selected channel IDs (Platform enums or SocialAccount IDs)
  postId         String?
  post           Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  assets         ProductReelAsset[]
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([seriesId])
  @@index([userId])
  @@map("reels")
}

model ProductReelAsset {
  id        String   @id @default(uuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  url       String
  type      String // IMAGE or VIDEO
  createdAt DateTime @default(now())

  @@index([reelId])
  @@map("product_reel_assets")
}

model CuratedPost {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       Platform
  externalPostId String   @map("external_post_id")
  content        String?
  mediaUrls      String[] @map("media_urls")
  metrics        Json?
  publishedAt    DateTime @map("published_at")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, platform, externalPostId])
  @@index([userId])
  @@map("curated_posts")
}

model SeriesCharacter {
  id            String     @id @default(uuid())
  seriesId      String     @map("series_id")
  series        ReelSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name          String
  demographics  Json?
  physical      Json?
  wardrobe      Json?
  mannerisms    Json?
  loraReference String?    @map("lora_reference")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([seriesId])
  @@map("series_characters")
}

model SeriesLocation {
  id           String     @id @default(uuid())
  seriesId     String     @map("series_id")
  series       ReelSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name         String
  architecture String?
  lighting     String?
  atmosphere   String?
  colorPalette Json?      @map("color_palette")
  keyObjects   Json?      @map("key_objects")
  cameraMood   String?    @map("camera_mood")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([seriesId])
  @@map("series_locations")
}

model SeriesObject {
  id        String     @id @default(uuid())
  seriesId  String     @map("series_id")
  series    ReelSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name      String
  material  String?
  details   String?
  scale     String?
  state     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([seriesId])
  @@map("series_objects")
}

model AdCreative {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productName String
  platform    String
  direction   String
  brief       Json
  imageUrl    String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("ad_creatives")
}

model PlaygroundImage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  imageUrl  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("playground_images")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model AutomatedCampaign {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteUrl     String             @map("website_url")
  schedule       String // e.g. '0 9,17 * * *' or 'daily'
  socialChannels String             @default("[]") @map("social_channels") // JSON array of account IDs
  isActive       Boolean            @default(true) @map("is_active")
  language       String?            @default("English")
  voiceId        String?            @default("Aoede") @map("voice_id")
  ingredientsToVideo Boolean        @default(false) @map("ingredients_to_video")
  imageToVideo       Boolean        @default(false) @map("image_to_video")
  animateImageCount  Int            @default(3) @map("animate_image_count")
  voicePrompt        String?        @map("voice_prompt")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  products       AutomatedProduct[]

  @@index([userId])
  @@map("automated_campaigns")
}

model AutomatedProduct {
  id          String            @id @default(uuid())
  campaignId  String            @map("campaign_id")
  campaign    AutomatedCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productUrl  String            @map("product_url")
  title       String
  description String?
  imageUrl    String?           @map("image_url")
  images      String?           // JSON array of image URLs
  status      String            @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  reelId      String?           @map("reel_id")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([campaignId, productUrl])
  @@index([campaignId, status])
  @@map("automated_products")
}
